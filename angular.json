{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "web",
  "projects": {
    "id-verification": {
      "projectType": "application",
      "root": "web",
      "sourceRoot": "web/src",
      "prefix": "idv",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "web/src/index.html",
            "browser": "web/src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "styles": ["web/src/styles.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "web/public"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "vendor/tesseract"
              },
              {
                "glob": "tesseract-core-*lstm.wasm.js",
                "input": "node_modules/tesseract.js-core",
                "output": "vendor/tesseract/core"
              },
              {
                "glob": "*.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "vendor/tesseract/lang"
              },
              {
                "glob": "*.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/pol/4.0.0_best_int",
                "output": "vendor/tesseract/lang"
              },
              {
                "glob": "vision_wasm_internal.{js,wasm}",
                "input": "node_modules/@mediapipe/tasks-vision/wasm",
                "output": "vendor/mediapipe"
              }
            ],
            "externalDependencies": ["fs", "path", "crypto"],
            "allowedCommonJsDependencies": [
              "@techstark/opencv-js",
              "tesseract.js",
              "regenerator-runtime/runtime"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/id-verification/",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "id-verification:build:production"
            },
            "development": {
              "buildTarget": "id-verification:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
